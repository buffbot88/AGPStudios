{
  "BRAINSTEM_KEY": "REPLACE_WITH_A_LOCAL_TEST_KEY",
  "web_only": false,
  "logging": {
    "level": "INFO"
  },
  "server": {
    "binary_path": "./bin/llama-server",
    "port": 18080,
    "threads": 1,
    "batch": 32
  },
  "model": {
    "file": "LFM2.5-1.2B-Instruct-Q8_0.gguf",
    "path": "./models/LFM2.5-1.2B-Instruct-Q8_0.gguf"
  },
  "inference": {
    "context": 4096,
    "max_tokens": 1024,
    "queue_limit": 1,
    "public_refresh_seconds": 10
  },
  "metrics": {
    "persist_path": "./logs/metrics.jsonl"
  }
}
